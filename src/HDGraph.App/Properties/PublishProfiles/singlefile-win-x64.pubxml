<?xml version="1.0" encoding="utf-8"?>
<!--
  Fallback for machines without the C++ toolchain: JIT runtime bundled into one self-extracting hdgraph.exe.
  Bigger and slower to start than the AOT profile, but needs nothing beyond the .NET SDK.

      dotnet publish src/HDGraph.App -p:PublishProfile=singlefile-win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishDir>bin\publish\singlefile-win-x64\</PublishDir>
  </PropertyGroup>
</Project>
