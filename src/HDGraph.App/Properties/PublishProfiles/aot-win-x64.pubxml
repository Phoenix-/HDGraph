<?xml version="1.0" encoding="utf-8"?>
<!--
  Native AOT: one self-contained hdgraph.exe, no .NET runtime and no DLLs next to it.

      dotnet publish src/HDGraph.App -p:PublishProfile=aot-win-x64

  Needs the Visual Studio C++ build tools (link.exe) on the machine; see README.md.
  Keep every publish *property* in this file: the profile is imported after the project body, so a PropertyGroup in the
  csproj conditioned on PublishAot never fires. Items and targets conditioned on PublishAot do work (evaluated later).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishDir>bin\publish\aot-win-x64\</PublishDir>

    <!-- Built-in COM interop does not exist under Native AOT; Avalonia talks to COM through its own MicroCom layer. -->
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>

    <!-- Directory.Build.props turns warnings into errors, publish included. The only ILC warnings today are the
         per-assembly summaries for Avalonia.Controls.DataGrid (a FluentAvalonia dependency this app never uses):
         IL2104 "produced trim warnings", IL3053 "produced AOT analysis warnings". Everything else, our code and
         FluentAvalonia 3.1 itself, is clean; keep this list short and re-check it after package upgrades. -->
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
  </PropertyGroup>
</Project>
